{
  "name": "ipl-auction",
  "version": "1.0.0",
  "description": "Real-time multiplayer IPL auction game with Twilight Scoreboard design",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,NEXT\" -c \"yellow.bold,cyan.bold\" \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "next dev -p 3000",
    "server:dev": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bot-sim": "tsx server/tests/bot-simulator.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.474.0",
    "next": "^14.2.23",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.10.10",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
