{
  "name": "ipl-auction",
  "version": "1.0.0",
  "description": "Real-time multiplayer IPL auction game with Twilight Scoreboard design",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/db-manager.ts ensure",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,NEXT\" -c \"yellow.bold,cyan.bold\" \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "next dev -p 3000",
    "preserver:dev": "tsx scripts/db-manager.ts ensure",
    "server:dev": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "preserver": "tsx scripts/db-manager.ts ensure",
    "server": "tsx server/index.ts",
    "db:start": "tsx scripts/db-manager.ts start",
    "db:stop": "tsx scripts/db-manager.ts stop",
    "db:status": "tsx scripts/db-manager.ts status",
    "build:server": "prisma generate",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bot-sim": "tsx server/tests/bot-simulator.ts",
    "test:browser": "tsx scripts/browser-verify.ts",
    "images:sync": "python scripts/acquire_player_photos.py",
    "images:force": "python scripts/acquire_player_photos.py --force"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.474.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0",
    "tsx": "^4.19.2",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie": "^0.6.0",
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.0.4"
  }
}
