# ==============================================================================
# IPL AUCTION — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# For production, set these variables in the respective Render and Netlify dashboards.
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# ==============================================================================
# 1. RENDER (AUTHORITATIVE BACKEND WEB SERVICE)
# Configure these in the Render Dashboard -> Service -> Environment
# ==============================================================================

# Database Connection String (TiDB Cloud Serverless or MySQL 8.0)
# Format: mysql://<username>:<password>@<host>:4000/<database_name>?sslaccept=strict
DATABASE_URL="mysql://your_tidb_user:your_tidb_password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/ipl_auction?sslaccept=strict"

# Node Environment ("production" on Render)
NODE_ENV="production"

# Listening Port (Render dynamically injects $PORT; local fallback 3001)
PORT=3001

# Primary Allowed Frontend Origin for CORS & Socket.IO
# Set to your exact Netlify domain without trailing slash:
CLIENT_ORIGIN="https://your-app.netlify.app"

# Comma-separated list of all allowed CORS origins
ALLOWED_ORIGINS="https://your-app.netlify.app,http://localhost:3000,http://localhost:3001"

# Cryptographic Session Secret (minimum 32 characters; generate with `openssl rand -hex 32`)
SESSION_SECRET="generate-a-secure-random-secret-key-at-least-32-chars-long"

# Minimum Participants to Start Auction (Default: 2; set to 1 for solo testing)
MIN_AUCTION_PARTICIPANTS=2


# ==============================================================================
# 2. NETLIFY (NEXT.JS FRONTEND SITE)
# Configure these in the Netlify Dashboard -> Site configuration -> Environment variables
# ==============================================================================

# Authoritative Render Backend Socket.IO URL
NEXT_PUBLIC_SOCKET_URL="https://your-backend.onrender.com"

# Authoritative Render Backend REST API URL
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"

# Server-Side Internal URL for Next.js API Routes Proxying
BACKEND_INTERNAL_URL="https://your-backend.onrender.com"

# Minimum Participants for Host UI Validation (matches backend threshold)
NEXT_PUBLIC_MIN_AUCTION_PARTICIPANTS=2

# Node Environment ("production" on Netlify)
NODE_ENV="production"


# ==============================================================================
# 3. LOCAL DEVELOPMENT DEFAULTS (.env)
# Used when running `npm run dev` on your local machine
# ==============================================================================
# DATABASE_URL="mysql://root:password@localhost:3306/ipl_auction"
# NODE_ENV="development"
# PORT=3001
# CLIENT_ORIGIN="http://localhost:3000"
# ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
# SESSION_SECRET="local-development-session-secret-must-be-at-least-32-chars"
# MIN_AUCTION_PARTICIPANTS=2
# NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
# NEXT_PUBLIC_API_URL="http://localhost:3001"
# BACKEND_INTERNAL_URL="http://localhost:3001"
# NEXT_PUBLIC_MIN_AUCTION_PARTICIPANTS=2

# ==============================================================================
# 4. NATURAL INDIAN FEMALE VOICE (TTS) CONFIGURATION
# High-fidelity broadcast announcements for Player Introduction & Sold Events
# ==============================================================================
# Provider selection: auto | azure | elevenlabs | google | fallback
TTS_PROVIDER="auto"

# Option A: Microsoft Azure Neural TTS (Recommended: en-IN-NeerjaNeural / en-IN-KavyaNeural)
# AZURE_SPEECH_KEY="your-azure-speech-resource-key"
# AZURE_SPEECH_REGION="centralindia"
# AZURE_SPEECH_VOICE="en-IN-NeerjaNeural"

# Option B: ElevenLabs Text-to-Speech (Indian English Female Voice)
# ELEVENLABS_API_KEY="your-elevenlabs-api-key"
# ELEVENLABS_VOICE_ID="XB0fDUnXU5powFXDhCwa"

# Option C: Google Cloud Neural2 Text-to-Speech (Voice: en-IN-Neural2-A)
# GOOGLE_TTS_API_KEY="your-google-cloud-api-key"
# GOOGLE_TTS_VOICE="en-IN-Neural2-A"
