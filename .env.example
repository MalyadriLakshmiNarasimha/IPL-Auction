# ==============================================================================
# IPL AUCTION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# RENDER (Authoritative Backend Server) Environment Variables
# ------------------------------------------------------------------------------
# TiDB Cloud or Hosted MySQL 8.0 connection string:
# Format: mysql://<user>:<password>@<host>:<port>/<database>?sslaccept=strict
DATABASE_URL="mysql://root:password@localhost:3306/ipl_auction"

# Node Environment: "production" on Render, "development" on local
NODE_ENV="development"

# Server Port (Render sets this dynamically via $PORT, local default 3001)
PORT=3001

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated if multiple)
CLIENT_ORIGIN="https://iplauctionlive.netlify.app"
ALLOWED_ORIGINS="https://iplauctionlive.netlify.app,http://localhost:3000,http://localhost:3001"

# Session & JWT signing secret (at least 32 random characters)
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Minimum participants to start auction (1 for solo test, 2 for multiplayer)
MIN_AUCTION_PARTICIPANTS=2

# ------------------------------------------------------------------------------
# NETLIFY (Next.js Frontend) Environment Variables
# ------------------------------------------------------------------------------
# Public API and WebSocket endpoint (points to Render backend in production)
NEXT_PUBLIC_API_URL="https://ipl-auction-jqsd.onrender.com"
NEXT_PUBLIC_SOCKET_URL="https://ipl-auction-jqsd.onrender.com"

# Minimum participants for client validation
NEXT_PUBLIC_MIN_AUCTION_PARTICIPANTS=2

# Internal URL used by Next.js server-side route proxies to reach Render backend
BACKEND_INTERNAL_URL="https://ipl-auction-jqsd.onrender.com"
