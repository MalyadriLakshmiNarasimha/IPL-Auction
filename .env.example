# Database connection for MySQL via Prisma ORM
DATABASE_URL="mysql://root:password@localhost:3306/ipl_auction"

# Session & Authentication Secret
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Server Ports & CORS
PORT=3001
CLIENT_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
NODE_ENV="development"

# Auction Participant Configuration (1 for local single-player testing, 2 for production multiplayer)
NEXT_PUBLIC_MIN_AUCTION_PARTICIPANTS=2
MIN_AUCTION_PARTICIPANTS=2

